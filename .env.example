# ── Telegram ─────────────────────────────────────────────
BOT_TOKEN=                   # from @BotFather
CHANNEL_ID=                 # e.g. -1001234567890 or @yourchannel
BOT_USERNAME=NextChampion_bot
ADMIN_TELEGRAM_IDS=         # comma-separated IDs, e.g. 123456789,987654321

# ── NextChamp ────────────────────────────────────────────
NEXTCHAMP_API_URL=https://api.nextchampion.app
NEXTCHAMP_FRONTEND_URL=https://nextchampion.app
MINI_APP_SHORT_NAME=app     # the short name you set in BotFather

# Shared secret for /v1/notifications/bot/* endpoints (x-bot-secret header)
BOT_SECRET=nextchamp_bot_secret_key

# ── Media ────────────────────────────────────────────────
GAMES_MEDIA_DIR=./assets/games
DEFAULT_MEDIA_PATH=./assets/default.jpg
WELCOME_MEDIA_PATH=./assets/welcome.jpg

# ── Links ────────────────────────────────────────────────
HELP_URL=https://nextchampion.app/contact

# ── Behavior ─────────────────────────────────────────────
POLL_INTERVAL_MS=5000
STATE_FILE=./data/state.json
DB_FILE=./data/bot.sqlite3